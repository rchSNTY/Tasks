@model List<DailyTask.Models.TaskModel>

<style>
    h2 {
        font-weight: 600;
        margin-bottom: 20px;
        color: #2c3e50;
    }

    .add-btn {
        background: linear-gradient(135deg, #1f4037, #99f2c8);
        color: white;
        padding: 8px 18px;
        border-radius: 25px;
        text-decoration: none;
        font-size: 14px;
        transition: 0.3s;
    }

        .add-btn:hover {
            color: #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transform: translateY(-2px);
        }

    .table-container {
        margin-top: 25px;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    thead {
        background: linear-gradient(135deg, #1f4037, #99f2c8);
        color: #ffffff;
    }

    th, td {
        padding: 14px 16px;
        text-align: center;
        font-size: 14px;
    }

    tbody tr {
        transition: background 0.3s;
    }

        tbody tr:hover {
            background: #f4f6f9;
        }

    .action-btn {
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        margin: 0 3px;
        transition: 0.3s;
    }

    .edit-btn {
        background: #3498db;
        color: #fff;
    }

    .delete-btn {
        background: #e74c3c;
        color: #fff;
    }

    .action-btn:hover {
        opacity: 0.85;
        color: #fff;
    }
</style>

<h2>Daily Task List</h2>

<a href="/Task/Create" class="add-btn">+ Add New Task</a>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Task</th>
                <th>Day</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Day</td>
                    <td>
                        <a href="/Task/Edit/@item.id" class="action-btn edit-btn">Edit</a>
                        <a href="/Task/Delete/@item.id" class="action-btn delete-btn"
                           onclick="return confirm('Are you sure you want to delete this task?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
