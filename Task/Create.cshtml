@model DailyTask.Models.TaskModel

@{
    ViewBag.Title = "Add Task";
}

<style>
    h2 {
        font-weight: 600;
        margin-bottom: 25px;
        color: #2c3e50;
        text-align: center;
    }

    .form-card {
        max-width: 500px;
        margin: auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        animation: fadeIn 0.4s ease-in;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: 500;
        margin-bottom: 8px;
        display: block;
        color: #34495e;
    }

    input[type="text"] {
        width: 100%;
        padding: 12px 15px;
        border-radius: 10px;
        border: 1px solid #ddd;
        font-size: 14px;
        transition: 0.3s;
        background-color: #f8f9fa;
    }

        input[type="text"]:focus {
            outline: none;
            border-color: #1f4037;
            box-shadow: 0 0 0 3px rgba(153, 242, 200, 0.4);
            background-color: #ffffff;
        }

    .btn-save {
        margin-top: 25px;
        width: 100%;
        padding: 12px;
        border-radius: 25px;
        border: none;
        background: linear-gradient(135deg, #1f4037, #99f2c8);
        color: #ffffff;
        font-weight: 500;
        font-size: 16px;
        transition: 0.3s;
        cursor: pointer;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .btn-save:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

    .validation-error {
        color: #e74c3c;
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }

    .field-validation-error {
        color: #e74c3c;
        font-size: 13px;
        margin-top: 5px;
        display: block;
    }

    .field-validation-valid {
        display: none;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 576px) {
        .form-card {
            padding: 20px 15px;
            margin: 0 10px;
        }

        h2 {
            font-size: 1.5rem;
        }
    }
</style>
<h2>Add Task</h2>

<div class="form-card">
    @using (Html.BeginForm("Create", "Task", FormMethod.Post, new { id = "createForm" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.Name)
            @Html.TextBoxFor(m => m.Name, new
            {
                @class = "form-control",
                placeholder = "Enter your name",
                required = "required",
                title = "Please enter your name"
            })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Description)
            @Html.TextBoxFor(m => m.Description, new
            {
                @class = "form-control",
                placeholder = "Enter task description",
                required = "required",
                title = "Please enter task description"
            })
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "validation-error" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Day)
            @Html.TextBoxFor(m => m.Day, new
            {
                @class = "form-control",
                placeholder = "e.g. Monday, Tuesday, etc.",
                required = "required",
                title = "Please enter day"
            })
            @Html.ValidationMessageFor(m => m.Day, "", new { @class = "validation-error" })
        </div>

        <button type="submit" class="btn-save" id="submitBtn">
            Save Task
        </button>

        <div style="margin-top: 15px; text-align: center;">
            <a href="@Url.Action("Index", "Task")" style="color: #1f4037; text-decoration: none;">
                ← Back to Task List
            </a>
        </div>
    }
</div>